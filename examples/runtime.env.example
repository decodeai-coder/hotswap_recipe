# systemd EnvironmentFile format: absolute paths, no shell expansion.
# Keep this file as an example; put your edited copy in your user configuration.
MODEL_FLEET_NODE=/usr/bin/node
MODEL_FLEET_CODE_ROOT=/absolute/path/fleet-hot-swap-recipe/runtime
MODEL_FLEET_DATA_ROOT=/absolute/path/fleet-state
MODEL_FLEET_STATE_PATH=/absolute/path/fleet-state/state.json
MODEL_FLEET_OUTPUT_ROOT=/absolute/path/fleet-output

MODEL_FLEET_HOST=127.0.0.1
MODEL_FLEET_PUBLIC_HOST=127.0.0.1
MODEL_FLEET_PORT=8199
MODEL_FLEET_SYSTEMCTL_SCOPE=user
MODEL_FLEET_AVAILABLE_PROFILES=qwen27-long,qwen35-long,idle

# The manager queries this GPU; CUDA_VISIBLE_DEVICES pins the example workers.
# Set both values to the SAME GPU UUID from nvidia-smi.
MODEL_FLEET_GPU_UUID=GPU-REPLACE-WITH-YOUR-UUID
CUDA_VISIBLE_DEVICES=GPU-REPLACE-WITH-YOUR-UUID
MODEL_FLEET_TEXT_HEALTH_URL=http://127.0.0.1:8091/health
# Optional media example: add media to AVAILABLE_PROFILES and install its unit.
MODEL_FLEET_COMFY_HEALTH_URL=http://127.0.0.1:8190/system_stats

# The minimal recipe does not require the original continuity sidecar,
# H3-specific preload nodes, or a separate residency/lease service.
MODEL_FLEET_MEDIA_CONTINUITY=0
MODEL_FLEET_MEDIA_PRELOAD=0
MODEL_FLEET_STICKY_MEDIA=0
MODEL_FLEET_EXTERNAL_LEASE_BASE_URL=
MODEL_FLEET_EXTERNAL_LEASE_ACQUIRE_URL=
MODEL_FLEET_EXTERNAL_LEASE_RENEW_URL=
MODEL_FLEET_EXTERNAL_LEASE_RELEASE_URL=
